# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/
frontend/public/data/    # generated by the Action; never commit

# Local Python (only needed if you run the script locally)
__pycache__/
*.pyc
.venv/

# Mac & editor cruft
.DS_Store
.vscode/
.idea/

# Raw data drop (you should never check the .tsv files in — they go in a Release)
raw/
*.tsv
!frontend/public/data/**.tsv  # safety net; the data folder is gitignored anyway

# Scratch
*.sqlite
