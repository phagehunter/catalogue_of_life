ve",""]]},"PKLLH":{"d":[["Southern Asia","","text","",""]]},"QMT36":{"d":[["North America","","text","",""]]},"QT2D":{"d":[["Cuban Exclusive Economic Zone","8406","mrgid","",""],["Cuban Exclusive Economic Zone","8406","mrgid","",""]]},"RB3T":{"d":[["","CPP","tdwg","",""],["","NAT","tdwg","",""],["","OFS","tdwg","",""]]},"RCB22":{"d":[["","TW","iso","native",""]]},"RH6YR":{"d":[["","TW","iso","native",""]]},"RJ4WT":{"d":[["North America","","text","",""]]},"RQ5C":{"d":[["Australasia","","text","native",""]]},"RTDY8":{"d":[["Distribution. Prokius cambrai sp. nov. was found between 1,440 – 2,070 m a. s. l. at Volcán Barú, Chiriqui, Panama.","","text","",""]]},"RTNG":{"d":[["ZA","ZA","iso","",""]]},"S3NG":{"d":[["New Zealand","2227","mrgid","",""]]},"S9BKB":{"d":[["Distribution. Pseudoscotaena polistoides also seem to be an abundant species, being recorded from regions of Chaco, Pantanal and Atlantic Forest. The known localities registered are: Paraná, Brazil (NHM – UK, MfN, MACN). Asunción, Paraguay (NHM – UK, MfN). San Bernardino, Paraguay (NHM – UK, MfN). Villa Monte, Bolivia; Uruguai (MfN). Paraguay (AMNH). Fazenda Rio Grande, Cajuru, São Paulo, Brazil; Parque Estadual de Vila Velha, Paraná, Brazil; 12 km SE from Jaíba, Minas Gerais, Brazil; Estação Ecológica de Jataí, Luís Antônio, São Paulo, Brazil; Macaé, Rio de Janeiro, Brazil (DZUP). Salgadeira, Cuiabá, Mato Grosso, Brazil (CEMT). Fazenda Floresta, Três Lagoas, Mato Grosso, Brazil (MZUSP). Macaubal, São Paulo, Brazil; Magda, São Paulo, Brazil; Planalto, São Paulo, Brazil (DZSJRP).","","text","",""]]},"SPJTZ":{"d":[["São Tomé","","text","",""]]},"SQQF":{"d":[["New Zealand","","text","native",""]]},"SRPCC":{"d":[["ISO 3166-2:CA-BC","","text","native",""],["ISO 3166-2:CA-MB","","text","native",""],["ISO 3166-2:CA-NB","","text","native",""],["ISO 3166-2:CA-NF","","text","native",""],["ISO 3166-2:CA-NS","","text","native",""],["ISO 3166-2:CA-ON","","text","native",""],["ISO 3166-2:CA-QC","","text","native",""],["ISO