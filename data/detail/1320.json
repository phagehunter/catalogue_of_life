3 μm wide are clearly visible on the surface of the chorion (Figs 28, 30).","","text","",""]]},"PVGV":{"v":[["Gestreepte zilvervlekbreedvoet","nld",0]]},"Q4XLZ":{"v":[["Netsporig mosschijfje (var. ratisboniensis)","nld",0]]},"RBL7L":{"v":[["tromsvalmue","nno",0],["tromsvalmue","nob",0]],"d":[["Norway","NO","iso","native",""],["Norway","NO","iso","native",""],["Norway","NO","iso","native",""],["Norway","NO","iso","native",""],["Norway","NO","iso","native",""],["Norway","NO","iso","native",""]]},"RCPL2":{"v":[["Mt. Shasta Swallowtail","eng",0],["Shasta Swallowtail","eng",0]],"d":[["North America","","text","",""]]},"RTSR8":{"v":[["磚色食蟲虻","zho",0]],"d":[["","TW","iso","native",""]]},"SJXBL":{"v":[["Violet-crowned Hummingbird (Northern)","eng",0]],"d":[["semiarid southwestern USA to western Mexico (Jalisco and Guanajuato)","","text","",""]]},"V5GX9":{"v":[["Splendid Stream Frogs","eng",0],["Katak Elok","ind",0]]},"VCDT2":{"v":[["Metallic-winged Sunbird (Bohol)","eng",0],["Boholhoningzuiger","nld",0],["Boholnektarvogel","deu",0],["Boholsolfugl","nob",0],["Souimanga de Bohol","fra",0],["boholinmedestäjä","fin",0],["nectarínia-de-bojol","por",0],["ボホルタイヨウチョウ","jpn",0]],"d":[["Philippines (Bohol)","","text","",""]]},"X3VB":{"v":[["Piktasis deguliagrybis","lit",0],["antracnose-da-cebola-branca","por",0],["黑棉狀炭疽刺盤孢菌","zho",0]]},"lfzPSoEGnxA_0dHeL-Hpp1":{"v":[["Lotiev's Viper","eng",0]]},"324TV":{"d":[["Mexico (Guerrero, Chiapas, Veracruz, Oaxaca); Guatemala; Belize; El Salvador; Honduras; Nicaragua; Costa Rica; Panama; Guadeloupe; Dominica; Martinique","","text","",""]]},"32545":{"d":[["","BZC","tdwg","",""],["","BZL","tdwg","",""],["","BZS","tdwg","",""],["","PAR","tdwg","",""]]},"32RX4":{"d":[["Southern Asia","","text","",""]]},"32VP8":{"d":[["New Guinea (Irian Jaya, Papua New Guinea)","","text","",""]]},"33274":{"d":[["Indonesia","","text","native",""]]},"342RX":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"342S7":{"d":[["Southern Asia","","text",""