,"native",""],["Australia","","text","native",""]]},"NC2RB":{"d":[["Norway","NO","iso","",""]]},"NM3QX":{"d":[["North America","","text","",""]]},"NM3R7":{"d":[["Sweden","SE","iso","native",""]]},"NNCNJ":{"d":[["Mediterranean Sea","1905","mrgid","native",""]]},"NQ2F":{"d":[["","CPP","tdwg","",""]]},"NXCN":{"d":[["Africa","","text","",""]]},"PYTBX":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"Q8ZT":{"d":[["CHXOO","","text","native",""]]},"Q99T":{"d":[["NE-Brazil (Bahia)","","text","",""]]},"QHD3G":{"d":[["Distribution. Endemic to the Solomon Islands. Yet recorded only from Guadalcanal (Fig. 14).","","text","",""]]},"QMKTZ":{"d":[["North America","","text","",""]]},"QW2J3":{"d":[["Auckland Islands","17378","mrgid","native",""],["Campbell Island","14798","mrgid","native",""]]},"RDMHL":{"d":[["North America","","text","",""]]},"RFD5F":{"d":[["Distribution: Neotropical (Chile, Ecuador). Records in Ecuador: Zamora Chinchipe (San Francisco Biological Reserve) and Loja (Podocarpus National ParkCajanuma). Habitat: Litter and soil from Graffenrieda emarginata. Litterbags of Clusia spp. and Hediosmum sp.","","text","",""]]},"RHWF":{"d":[["CHS-HN","CHS-HN","tdwg","",""]]},"RJGBR":{"d":[["Australia","","text","",""]]},"S2GGD":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"S3SKS":{"d":[["","TW","iso","native",""]]},"SGR29":{"d":[["Southern Asia","","text","",""]]},"SQBQ":{"d":[["","JAW","tdwg","",""],["","SUM","tdwg","",""]]},"SY38":{"d":[["European waters (ERMS scope)","7130","mrgid","",""],["High Seas","63203","mrgid","",""],["North East Atlantic","5664","mrgid","",""],["Norwegian Exclusive Economic Zone","5686","mrgid","",""],["Norwegian Exclusive Economic Zone","5686","mrgid","",""],["Norwegian Exclusive Economic Zone","5686","mrgid","",""],["Norwegian Exclusive Economic Zone","5686","mrgid","",""]]},"V3QCZ":{"d":[["Distribution. Brachistosternus pehuenche is currently known only from the upper basin of the Maule Valley, located in the Maule Region of central Chile. This region lies within the Andean Mauline forests, characterized by a complex landscape of valleys and mountain ranges ranging from approximately 1000 to 1800 m a. s. l. The scorpion has been collected in a variety of microhabitats within this elevation range, including shrub steppes, gramineous steppes, and dry woodlands, but it appears to be more abundant in open environments like shrub and gramineous steppes. The distribution of B. pehuenche appears to be tightly restricted to the upper Maule Valley, as no specimens have been found in adjacent areas despite extensive fieldwork performed by our group in the different seasons of the year (see below). For example, surveys conducted in the Altos del Lircay Reserve to the north and the Pejerrey area to the south failed to detect the species, further supporting the hypothesis of its endemism to the Maule Valley. Instead, B. negrei, a closely related species, dominates in these neighboring regions, underscoring the geographic and ecological isolation of B. pehuenche.","","text","",""]]},"V3QD9":{"d":[["China","","text","",""]]},"V58PD":{"d":[["Slovakia (Velká Fatra)","","text","",""]]},"V5CYP":{"d":[["New Guinea (Irian Jaya, Papua New Guinea)","","text","",""]]},"VC239":{"d":[["Chilean part of the South Pacific Ocean","25660","mrgid","",""]]},"W33Z":{"d":[["Argentine Basin","6666","mrgid","",""]]},"W349":{"d":[["","BO","iso","",""]]},"WPWY":{"d":[["China","","text","",""]]},"WQ6Y":{"d":[["Africa","","text","",""]]},"WQ78":{"d":[["Africa","","text","",""]]},"YGDS":{"d":[["Iraq (SE-Iraq: Mesopotamia); Syria (C-Syrian Desert, Jazira); Saudi Arabia (N-Saudi Arabia)","","text","",""]]},"ZDGR":{"d":[["","BIS","tdwg","",""],["","MOL","tdwg","",""],["","NWG","tdwg","",""]]},"ZKY9":{"d":[["","TUR","tdwg","",""]]}}