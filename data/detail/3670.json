"3558","mrgid","native",""],["Tyrrhenian Sea","3386","mrgid","native",""]]},"RPVB7":{"d":[["Australia","","text","",""]]},"SDFBR":{"d":[["Distribution in Iran. Fars, Qom, Sistan & Baluchestan (Švihla 1983 as A. comata). General distribution. Iran (Švihla 2008 a, b), Iraq, Jordan, Saudi Arabia (Švihla 2008 a). Chorotype. SW-Asiatic.","","text","",""]]},"SDLN":{"d":[["European waters (ERMS scope)","7130","mrgid","",""],["Irish Exclusive economic Zone","5681","mrgid","",""]]},"SP4Z":{"d":[["N.E. & Central Brazilian","","text","native",""]]},"SP59":{"d":[["W. & Central Asia","","text","native",""]]},"SZMQF":{"d":[["Norway","NO","iso","",""]]},"T86CL":{"d":[["Distribution. India: Andaman & Nicobar Islands (new record), Karnataka, Kerala (new record), Maharashtra (new record), Tamil Nadu, Uttarakhand (new record). Elsewhere: Thailand.","","text","",""]]},"TCZ9G":{"d":[["","TW","iso","native",""]]},"TFF8Y":{"d":[["Nearctic","","text","native",""]]},"TLY8":{"d":[["North Carolina","8929","mrgid","",""]]},"TML7M":{"d":[["Distribution. INDONESIA, Maluku (Ceram Isl., Batchian Isl.?). Notes. Pascoe (1871) did not designate a holotype in the original description nor specify the number of specimens examined. Four syntypes could be located, two each from Ceram and Batchian. Other specimens may exist in addition to them. The male from Ceram is here designated lectotype to ensure stability of nomenclature in case additional syntypes are discovered that belong to different species. Originally, two specimens were each mounted on one card and provided with one set of labels. The specimens were mounted on cards on separate pins by the present author. Locality data were transcribed to a second set of labels for the female specimens. Two undescribed species from Waigeo Island, respectively from Salawatti and Batanta Islands are similar to T. ellipticus (Pascoe), but can be distinguished by slightly deeper and denser punctation of the pronotum, slightly more distinct femoral teeth and most clearly by a different structure of aedeagus and transfer apparatus. It is likely that T. ellipticus (Pascoe) is endemic to Maluku. Considering the degree of endemism usually exhibited by Trigonopterus species, it is somewhat surprising that specimens from Ceram and Bacan look almost identical. Additional fieldwork is needed to clarify if T. ellipticus (Pascoe) occurs on both islands, or if it is an endemic to only one of them, with the record of the other being incorrect.","","text","",""]]},"V3P6B":{"d":[["Tanzania","","text","",""]]},"V5N4D":{"d":[["Czech Republic","48119","mrgid","",""]]},"VC7WJ":{"d":[["France","47630","mrgid","",""]]},"VC86J":{"d":[["China (Hubei, Sichuan); N-Vietnam","","text","",""]]},"VCFY9":{"d":[["Global","","text","native","endangered"]]},"VCG7Z":{"d":[["Russia","RU","iso","native",""]]},"X9SM":{"d":[["China","","text","native",""]]},"Y6VL":{"d":[["[Western] Samoa (Savai'i)","","text","",""]]},"ZJKB":{"d":[["Mexico (Chiapas, Guerrero, Oaxaca, Puebla, Tamaulipas, Veracruz); Guatemala","","text","",""]]},"ZNCF":{"d":[["","ANG","tdwg","",""],["","TAN","tdwg","",""],["","ZAM","tdwg","",""]]}}