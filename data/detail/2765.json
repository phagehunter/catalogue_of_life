]]},"L6KC8":{"d":[["Distribution The species is known from a single locality in Peru: Loreto, Iquitos, Sachamama (Figure 7).","","text","",""],["Type locality. Peru, Loreto, Iquitos, Sachamama.","","text","",""]]},"LBMYT":{"d":[["Oceania","","text","",""]]},"LH4ZF":{"d":[["Distribution: Neotropical species, Mesoamerica, northern and middle South America (Niedbała 2004). Records in Bolivia: BOL- 015, (1 ex.).","","text","",""]]},"LVHGW":{"d":[["Distribution (for map see Fig. 72). In addition to a photograph of the holotype, I examined 20 specimens from: Bolivia: Departamento de Santa Cruz, near Potrerillos, 27 - 29 - X- 2013, 430 m, Wappes & Kuckartz; 3.7 km SSE Buena Vista, Hotel Flora & fauna, 14 - 19 - X- 2000, 430 m, M. C. Thomas. Brazil: Estado do Goías, Mineiro Goyaz. Specimens are deposited in: ACMT, FSCA, MNHN, and WOPC. Notes. A photograph of the holotype was examined. The redescription is based on a non-type specimen.","","text","",""]]},"MBFS":{"d":[["Oriental(India:Tamil Nadu)","","text","",""]]},"MBG2":{"d":[["Palaearctic(Nepal)","","text","",""]]},"MWNTB":{"d":[["","TW","iso","native",""]]},"MXYJ":{"d":[["SRL","SRL","tdwg","",""]]},"MY8J":{"d":[["Ecuador","","text","",""]]},"NCB5":{"d":[["Gulf of Mexico","4288","mrgid","",""]]},"P5WL":{"d":[["Indonesia(Kalimantan)","","text","",""]]},"P66L":{"d":[["CHSFJ","","text","native",""]]},"P689Q":{"d":[["Africa","","text","",""]]},"PT9K":{"d":[["","BLZ","tdwg","",""],["","BOL","tdwg","",""],["","BZE","tdwg","",""],["","CLM","tdwg","",""],["","COS","tdwg","",""],["","GUA","tdwg","",""],["","HON","tdwg","",""],["","LEE","tdwg","",""],["","MXC","tdwg","",""],["","MXG","tdwg","",""],["","MXN","tdwg","",""],["","MXS","tdwg","",""],["","MXT","tdwg","",""],["","NIC","tdwg","",""],["","PAN","tdwg","",""],["","VEN","tdwg","",""],["","WIN","tdwg","",""]]},"Q2ZK":{"d":[["AU, Queensland","","text","native",""]]},"Q5GYB":{"d":[["","WSB","tdwg","",""]]},"QBCYY":{"d":[["","TW","iso","native",""]]},"QMDF":{"d":[["S-Oman (Dhofar