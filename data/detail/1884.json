ric with the closely related P. sparsus (Lodos et al. 2003). In 2024 P. rufulus was collected in Hyrcanian forests, Mazandaran Province of Iran (first country record); photographs of one specimen were received from Zahra Azizi (Environmental Science Department, Tarbiat Modares University, Noor, Iran) and examined by the first author.","","text","",""]]},"6WFD":{"d":[["African Indian Desert","","text","native",""],["Europe","","text","native",""],["Mediterranean","","text","native",""]]},"6WRMK":{"d":[["IN","IN","iso","",""]]},"6XSHN":{"d":[["REU-00 (Reunion aggregation)","","text","",""]]},"6XZYV":{"d":[["Borneo","","text","",""]]},"6Y9YV":{"d":[["NWG-PN","NWG-PN","tdwg","",""]]},"6YPKM":{"d":[["Cook Strait","4369","mrgid","",""],["New Zealand Exclusive Economic Zone","8455","mrgid","native",""]]},"6Z3CQ":{"d":[["","CHC-SC","tdwg","native",""],["China (Sichuan)","","text","native",""]]},"6ZJ5H":{"d":[["","ECU","tdwg","",""]]},"6ZQFP":{"d":[["","JAP-HN","tdwg","native",""],["Japan (Honshu)","","text","native",""]]},"6ZXWX":{"d":[["Madagascar","","text","",""]]},"724VD":{"d":[["","MDG-OO","tdwg","native",""],["Madagascar","","text","native",""]]},"73WLJ":{"d":[["Myanmar","","text","native",""]]},"7433F":{"d":[["","PHI","tdwg","",""]]},"74B4V":{"d":[["OrientaL (Indomalaya)","","text","native",""]]},"764JL":{"d":[["Philippines (S Luzon)","","text","",""]]},"768BP":{"d":[["Liberia","","text","",""]]},"76RMK":{"d":[["Moreton Bay","14655","mrgid","",""]]},"77KXF":{"d":[["Colombia (Amazonas, Vaupés); Venezuela (Amazonas, Bolívar); Guyana","","text","",""]]},"77L7F":{"d":[["Ecuador","","text","",""]]},"77ZZ5":{"d":[["Georgia [Caucasus]","","text","",""]]},"789YV":{"d":[["Barents Sea","4247","mrgid","",""],["Barents Sea","4247","mrgid","",""],["Barents Sea","4247","mrgid","",""],["Canadian Atlantic Coast","14910","mrgid","",""],["Canadian Atlantic Coast","14910","mrgid","",""],["East Greenland Shelf","21825","mrgid","",""],["European waters (ERMS scope)","7130","mrgid","",""]