kweed","eng",0],["alpine mouse-ear chickweed","eng",0],["Alpine Mouse-Ear","eng",0],["Alpen-Hornkraut (DE)","",0],["Alpine Mouse-ear (EN)","",0],["fjällarv","swe",0],["céraiste alpin","fra",0],["céraiste des Alpes","fra",0],["alášsáhpánrássi","sme",0],["fjellarve","nob",0],["várresáhpánrássi","sme",0],["Clust Llygoden Creigiau Mynyddig","cym",0],["Clust Llygoden Mynyddig","cym",0],["Clust-y-Llygoden Alpaidd","cym",0],["tunturihärkki","fin",0],["Alpen-Hornkraut","deu",0],["Artengruppe Alpen-Hornkraut","deu",0],["Ceraiste des Alpes","fra",0],["Peverina alpina","ita",0]],"d":[["Iceland; Jan Mayen; Svalbard; England (N-England, Scotland); Norway; Sweden; Finland; Germany (Bayern); Switzerland; Liechtenstein; Austria; Poland; Slovakia; Spain (Pyrénées); Andorra; France; Italy; North Macedonia; Romania; Bulgaria; N-European Russia; Ukraine; Siberia (W-Siberia); Pakistan (Kurram, Chitral, Gilgit); NW-India (Jammu & Kashmir); Greenland; Canada (Manitoba, Newfoundland, Labrador, N. W. T., Nunavut, Ontario, Quebec, Saskatchewan)","","text","",""]]},"SSMYQ":{"v":[["волнянка запылённая","rus",0],["ゴマフリドクガ","jpn",0],["碎黃毒蛾","zho",0],["꼬마독나방","kor",0]]},"TF9FD":{"v":[["Brilleneidechse","deu",0]],"d":[["","BAL","tdwg","uncertain",""]]},"V4KP8":{"v":[["Weixin Leaf Litter Toad","eng",0]],"d":[["Distribution and ecology. At present, this species is known to be distributed only in its type locality, that is, the mountains around Shizigou Village, Zhaxi Town, Weixin County, with an altitude of 1280 – 1400 meters. During the breeding season, it gathers in mountain streams with a width of 1.5 – 2 meters, surrounded by typical subtropical evergreen broad-leaved forests and bamboo forests (Fig. 5). The stream has a steep slope and low water temperature. There are often waterfalls and pools. The banks are covered with lush plants, mainly grasses. The village can be seen about 1 km away from the stream. Species that inhabit the same environment include Nanorana yunnanensis and Bufo andrewsi. During a field survey in mid-June, male toads were heard chirping in the cracks of huge rocks or under grass leaves beside streams. The chirping sound was like a cricket and varied. When not disturbed, the chirping sound consisted of two syllables, with an interval of about 0.5 seconds between each segment. When stimulated by light or someone passing by, the chirping sound changed to a long single syllable. After the environment stabilized, the chirping sound gradually returned to its former state. If further stimulated, such as by direct light, the toad stopped chirping, shrank into the cracks of the rocks, or crouched until it felt that the surrounding environment was safe. However, no tadpoles were observed during this period, nor were female toads.","","text","",""]]},"Y9DG":{"v":[["Golden-girdled Coralfish","eng",0],["Goldengirdled Coralfish","eng",0],["Goldon-girdled Coralfish","eng",0],["Orange-banded Coralfish","eng",0],["Orangebanded Coralfish","eng",0],["Bagang","und",0],["Bæltefanefisk","dnj",0],["Keper","und",0],["Keper laut","und",0],["Kiper laut","und",0],["Kisujigenrokudai","jpn",0],["Paro-paro","und",0],["Paru-parung dagat","und",0],["キスジゲンロクダイ","jpn",0],["Boray-boray","ceb",0],["Coradion à bandes orange","fra",0],["Kalaykalay","tbk",0],["Peix papallona de Queensland","cat",0],["Peixe-borboleta-de-listras-laranja","por",0],["Pesce farfalla cinto di giallo","ita",0],["Pesce farfalla fascia arancione","ita",0],["Pez Mariposa de Bandas Naranjas","spa",0],["zobec oranžovoploutvý","ces",0],["Бабочка-корадион хризонус","rus",0],["ปลาผีเสื้อเกล็ดทองครีบยาว","tha",0],["大斑馬","zho",0],["少女魚","zho",0],["金斑少女魚","zho",0]]},"uPunLgHbtK8E8SeTlOvC40":{"v":[["dished threetooth","eng",0]]},"32SRS":{"d":[["Mexico (Colima, Guerrero, Jalisco, México State, Michoacán)","","text","",""]]},"32SS2":{"d":[["SE-Brazil (São Paulo); S-Brazil (Paraná, Santa Catarina, Rio Grande do Sul)","","text","",""]]},"336JW":{"d":[["","COL-OO","tdwg","native",""],["","KAN-OO","tdwg","native