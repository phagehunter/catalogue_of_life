d rounded at apex, which is slightly longer than diverticulum, and provided with a moderately long and thin accessory gland at base; diverticulum and spermatheca surrounded with a strongly sclerotized ring at base, which is confluent in middle and extending to median oviduct on ventral side, the opening of spermatheca arising from middle of the sclerotized ring on dorsal side. Body length (both sexes): 17.0 ‒ 20.0 mm; width: 4.0 ‒ 5.0 mm.","","text","",""]]},"V4TKK":{"d":[["BR","BR","iso","",""]]},"V96Y6":{"d":[["England","16","mrgid","",""]]},"VC87L":{"d":[["Namaqua","21832","mrgid","",""]]},"VZ8L":{"d":[["Peru","","text","",""]]},"WDB7":{"d":[["Colombia (Cauca)","","text","",""]]},"XPFF":{"d":[["Guyana","","text","",""]]},"XX6N":{"d":[["France","17","mrgid","",""]]},"Y6WN":{"d":[["","51","tdwg","native",""],["New Zealand","","text","native",""]]},"YXRQ":{"d":[["Neotropical(Mexico:Chiapas, Oaxaca, Veracruz)","","text","",""]]}}