nal stripes; caudal filaments very short. Setae dark, short, several dorsal and subdorsal clubbed at the tip. Legs and prolegs cream colored; abdominal spiracle globose. Larval length: 1.8 – 2.0 mm (n = 10 / DZUPIL 0122).","","text","",""]]},"FfnEe0BcMD7Z50mbWxmIk1":{"v":[["Shasta Blue","eng",0]]},"HMD7":{"v":[["Bluespotted Dottyback","eng",0],["Longfin Dottyback","eng",0],["Pseudodonzela-de-barbatana-longa","por",0],["sapínovec znamenaný","ces",0]]},"HXMC":{"v":[["Pagumpa Milkvetch","eng",0],["Veyo Milkvetch","eng",0]],"d":[["","ARI","tdwg","",""],["","NEV","tdwg","",""],["","UTA","tdwg","",""]]},"KVFT5":{"v":[["Изопсетты","rus",0],["等鰭鰈屬","zho",0]]},"LR9VC":{"v":[["Zilversparblindwants","nld",0]]},"MKT22":{"v":[["cup lichen","eng",0]]},"NZ7Q":{"v":[["Pale Bolete","eng",0],["sommarsopp","swe",0],["sommarrøyrsopp","nno",0],["sommerrørsopp","nob",0],["Sølvskinnende rørhat","dan",0],["Bleke boleet","nld",0],["Bolet de Fetchner","fra",0],["Fakó tinóru","hun",0],["Fechtneri kivipuravik","est",0],["Fechtnerio baravykas","lit",0],["Fechtnerio sviestbaravykis","lit",0],["Fechtnerjev maslenec","slv",0],["Sommer-Röhrling","deu",0],["borowik blednący","pol",0],["hřib Fechtnerův","ces",0],["masłoborowik blednący","pol",0],["Болет Фехтнера","rus",0]]},"R7QV":{"v":[["terčovník aleutský","ces",0]]},"R7R5":{"v":[["terčovník crozetenský","ces",0]]},"TP9S":{"v":[["붉은수중다리고치벌","kor",0]]},"TSRW":{"v":[["svartbent örtblomfluga","swe",0],["svartfoturteblomsterflue","nob",0],["svartfoturteblomsterfluge","nno",0],["mustakeilanen","fin",0],["Zwartpootgitje","nld",0],["Sortfodet urtesvirreflue","dan",0]]},"VQQ8":{"v":[["ダンダラナツモモ","jpn",0]],"d":[["European waters (ERMS scope)","7130","mrgid","",""],["Madeiran Exclusive Economic Zone","8363","mrgid","",""]]},"WCJL":{"v":[["タニカワフクログモ","jpn",0],["瀧川氏袋蛛","zho",0]],"d":[["China, Taiwan, Japan (Ryukyu Is.)","","text","",""]]},"YLR9":{"v":[["olívsárga pókhálósgomba","hun",0]]},"326BS":{"d":[["Haiti","","text","native",""]]},"33MPM":{"d":[["China (Gu