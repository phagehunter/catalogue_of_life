 to Senna sp.","","text","",""]]},"LCCF":{"d":[["","CLM-OO","tdwg","native",""],["","VEN-OO","tdwg","native",""],["Venezuela, Colombia","","text","native",""]]},"LNLR":{"d":[["Oriental(India:Kerala)","","text","",""]]},"LR3YN":{"d":[["Norway","NO","iso","",""]]},"M253Q":{"d":[["Distribution. Australia (Queensland and New South Wales).","","text","",""]]},"MCJTJ":{"d":[["Australia","","text","",""]]},"MCRDR":{"d":[["Norway","NO","iso","",""],["Norway","NO","iso","",""]]},"MMDC7":{"d":[["SE-D.R.Congo [Zaire]","","text","",""]]},"MYFYS":{"d":[["Distribution. Azerbaijan, Armenia, Georgia, Greece (Crete), Turkey.","","text","",""]]},"N2XH8":{"d":[["","TW","iso","native",""]]},"NFD4L":{"d":[["Denmark","DK","iso","","not evaluated"]]},"NK5CG":{"d":[["Southern Asia","","text","",""]]},"P2PP6":{"d":[["Distribution. Indonesia [Bali, Sulawesi, Flores, Java, Kalimantan (new record)], Philippines, China, India, England, Iceland, Italy, Greece, South Africa, Congo, and North America.","","text","",""]]},"PFPR":{"d":[["Indonesia (Sulawesi)","","text","",""]]},"PL9P3":{"d":[["Norway","NO","iso","native",""]]},"Q2JX3":{"d":[["Overlapping claim Falkland / Malvinas Islands: United Kingdom / Argentina","8389","mrgid","native",""],["Overlapping claim South Georgia and the South Sandwich Islands: United Kingdom / Argentina","8383","mrgid","native",""],["South Georgia","21927","mrgid","native",""]]},"Q6G37":{"d":[["","TW","iso","native",""]]},"QGL4":{"d":[["European waters (ERMS scope)","7130","mrgid","",""],["Greek Exclusive Economic Zone","5679","mrgid","",""],["Greek Exclusive Economic Zone","5679","mrgid","",""],["Mediterranean Sea","1905","mrgid","",""],["Sudanese Exclusive Economic Zone","8355","mrgid","uncertain",""],["West Ireland","17652","mrgid","",""]]},"QWT4H":{"d":[["Southern Asia","","text","",""]]},"QY3PK":{"d":[["Norway","NO","iso","",""]]},"R483G":{"d":[["Angola","","text","",""]]},"RDNT":{"d":[["SW Africa","","text","native",""]]},"RSPC":{"d":[["AU","AU","iso","",""],["A