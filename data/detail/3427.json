uated"]]},"S5D2":{"d":[["GD","GD","iso","",""],["VCT","VC","iso","",""]]},"SBSFP":{"d":[["Distribution. Colombia: Antioquia, Chocó (Fig. 23 C).","","text","",""]]},"SHB7J":{"d":[["Distribution. The species is known only from the type locality, the C ần Gi ờ Mangrove Biosphere Reserve, South Vietnam.","","text","",""]]},"SMBH4":{"d":[["North America","","text","",""]]},"SS8J6":{"d":[["Distribution and Habitat — Distributed worldwide in tropical and subtropical zones between approximately 35 ° N and 42 ° S (Fig. 10). The limiting factor seems to be the occurrence and duration of frost (Lonard and Judd 1997). The main habitats are coastal areas where the plants grow on beaches and adjacent dunes, but it also occurs in disturbed areas. The species is occasionally found farther inland and in those cases appears to follow rivers. Optimal growth rates are only reached on saline soils (Messedi et al. 2004), but the plant is also found in non-saline habitats.","","text","",""]]},"SSFR":{"d":[["Middle America","","text","",""]]},"SVN52":{"d":[["Distribution. U. S. A.: Washington, Idaho, Utah, California, Arizona, Colorado; Canada: Saskatchewan, Alberta, Yukon.","","text","",""]]},"SYWXC":{"d":[["Distribution. Bulgaria, Asia Minor (Alonso-Zarazaga 2011 a).","","text","",""]]},"T2GKF":{"d":[["Distribution. Known from Borneo and Sumatra.","","text","",""]]},"TP7Q2":{"d":[["Sweden","SE","iso","native","not evaluated"]]},"V5BDM":{"d":[["Guangdong","","text","",""],["Hainan","","text","",""],["Hunan","","text","",""]]},"V7H36":{"d":[["Czech Republic","48119","mrgid","",""]]},"VCC8J":{"d":[["Middle America","","text","",""]]},"VCFQN":{"d":[["Norway","NO","iso","native",""]]},"WCZJ":{"d":[["Colombia (Vaupés)","","text","",""]]},"Z7JC":{"d":[["Namibia; South Africa (N-Cape Prov.)","","text","",""]]},"ZFL2":{"d":[["Fiji Islands","21994","mrgid","",""],["Samoa Islands","21838","mrgid","",""],["Tonga Islands","21998","mrgid","",""],["Tutuila","18525","mrgid","",""],["Vanuatu","21996","mr