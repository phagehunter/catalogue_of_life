acher, 1913, syn. nov.","","text","",""]]},"S2JP2":{"d":[["DISTRIBUTION. North-eastern Laos.","","text","",""]]},"SSDWP":{"d":[["South America","","text","",""]]},"T7CC":{"d":[["NWM","NWM","tdwg","",""]]},"TTZDK":{"d":[["","TW","iso","native",""]]},"TZ2CN":{"d":[["Distribution. The Bailongtan Mountains, Lanping County, Nujiang Lisu Autonomous Prefecture, Yunnan Province, China.","","text","",""]]},"TZWX4":{"d":[["","KRI","tdwg","",""]]},"V3Q3D":{"d":[["Kenya; Tanzania; Mozambique","","text","",""]]},"V3XDL":{"d":[["Africa","","text","",""]]},"V5JZB":{"d":[["EHM-SI","EHM-SI","tdwg","",""]]},"V5RJJ":{"d":[["NE-India (Meghalaya); Andaman Isl.; Thailand; Laos; Vietnam; peninsular Malaysia","","text","",""]]},"VC8TL":{"d":[["Ivory Coast","","text","",""],["Ivory Coast, Ghana, Nigeria","","text","",""]]},"VSDD":{"d":[["Bonaparte Coast","21923","mrgid","",""]]},"Z4VM":{"d":[["","GUA","tdwg","",""],["","MXC","tdwg","",""],["","MXG","tdwg","",""],["","MXS","tdwg","",""],["","MXT","tdwg","",""]]},"ZVQP":{"d":[["Middle America","","text","",""]]}}