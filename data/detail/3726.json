 species of the genus.","","text","",""]]},"TT3V8":{"d":[["France","48144","mrgid","native",""],["France","48144","mrgid","native",""]]},"TTJW":{"d":[["Zimbabwe, South Africa","","text","",""]]},"TTK6":{"d":[["Congo","","text","",""]]},"TXFD3":{"d":[["","TW","iso","native",""]]},"TYRHB":{"d":[["","TW","iso","native",""]]},"V64GB":{"d":[["Distribution. This species is only known from grassland and shrub páramo from Mt. Mojanda, province of Imbabura, Ecuador.","","text","",""]]},"V9MKB":{"d":[["DISTRIBUTION. — Early Miocene. Proto-Mediterranean Sea: Greece (this paper).","","text","",""]]},"V9XTN":{"d":[["Guizhou","48036","mrgid","",""]]},"VNQ4":{"d":[["Panamanian part of the North Pacific Ocean","25565","mrgid","",""]]},"WKT3":{"d":[["Mexico (Chiapas, Quintana Roo); Guatemala; Honduras; Nicaragua; Costa Rica; Panama; Colombia (Antioquia, Bolívar, Cauca, Chocó, La Guajira, Magdalena, Meta, Tolima); Venezuela (Apure, Aragua?, Barinas, Bolívar, Venezuela Distrito Federal, Falcon, Merida, Miranda, Nueva Esparta?, Portuguesa, Tachira?, Yaracuy, Zulia); Guyana; Ecuador; Peru; Bolivia (Beni, Pando); N-Brazil (Pará, Amazonas, Acre, Rondônia)","","text","",""]]},"XHW2":{"d":[["PE","","text","native",""]]},"XWXB":{"d":[["Hawaiian Islands","15270","mrgid","",""],["Philippine Exclusive Economic Zone","8322","mrgid","",""]]},"Y77B":{"d":[["","AU","iso","",""]]},"ZJLY":{"d":[["Colombia (Nariño); Peru; Bolivia (La Paz)","","text","",""]]},"ZV5D":{"d":[["Neotropical(French Guiana)","","text","",""]]}}