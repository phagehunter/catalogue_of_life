lusive Economic Zone","8455","mrgid","",""],["New Zealand Exclusive Economic Zone","8455","mrgid","",""]]},"Q2P5P":{"d":[["Yunnan","","text","",""]]},"QMLKC":{"d":[["North America","","text","",""]]},"QMPCG":{"d":[["North America","","text","",""]]},"QTNQT":{"d":[["Sea of Japan/East Sea","21847","mrgid","native",""]]},"QYS9B":{"d":[["Distribution. Brazil: Pará (Fig. 27).","","text","",""]]},"RB668":{"d":[["Norway","NO","iso","native",""]]},"RF4L":{"d":[["Namibia","","text","",""]]},"RMF3":{"d":[["Africa","","text","",""]]},"RSSFZ":{"d":[["DISTRIBUTION: Sierra Madre from C. Chiapas (Mexico), south through S. W. Guatemala.","","text","",""]]},"SMSTQ":{"d":[["DISTRIBUTION: Ticao Isl. (Philippines).","","text","",""]]},"SRLT3":{"d":[["North America","","text","",""]]},"SZP4G":{"d":[["North America","","text","",""]]},"TGX9L":{"d":[["Africa","","text","",""]]},"TJ4XN":{"d":[["","CHT","tdwg","",""]]},"TJW2Q":{"d":[["Distribution. Endemic to Mt. Choke in northern Ethiopia. Based on Quéinnec et al. (2021) and new sampling data, the species occurs on top of the western crater rim and on western slope of the crater valley, as well as on the north-facing mountain range north of the village Waber (Fig. 4). Habitat preferences. Quéinnec et al. (2021) collected most specimens of the type series under clay at the base of a small cliff. The additional specimens of T. reebae were collected under stones and sifted from the humus-rich soil under dense vegetation alongside small streams, and no specimens were found on open pastures and in dry bushland areas. For the vertical distribution altitudes of 3500 to 3900 m were noted (see also Quéinnec et al. 2021). Based on these data, the new species can be considered hygrophilic and cold-adapted.","","text","",""]]},"V3BYT":{"d":[["Sergipe","48012","mrgid","",""]]},"V44SG":{"d":[["Geographical distribution. Corydoras colossus is so far only known from the rio Jutaí, reportedly near its confluence with the rio Solimões, Amazon basin, Amazonas State, Brazil (Fig. 12). It is possible that it is found in the streams that drain into the main river, or further upstream (H. Bleher, 2022, pers. comm.). Fuller, Evers (2011) state that the first specimens introduced into the hobby were reportedly from Lago Aiapuá, rio Purus, but this has since been corrected in the aquarium literature to rio Jutaí.","","text","",""]]},"V452G":{"d":[["Distribution China (Xizang).","","text","",""]]},"V6HD":{"d":[["EG","EG","iso","",""],["IL","IL","iso","",""],["JO","JO","iso","",""],["PSE","PS","iso","",""],["SIN","SIN","tdwg","",""]]},"V6Q3H":{"d":[["Distribution. Ethiopia.","","text","",""]]},"V9ZVY":{"d":[["","MX","iso","",""]]},"VBWBG":{"d":[["","CO","iso","",""]]},"VXCG":{"d":[["","BZL","tdwg","",""],["","BZS","tdwg","",""]]},"XCGV":{"d":[["Costa Rica; Panama; Colombia (Antioquia, Boyacá, Caldas, Caquetá, Cauca, Chocó, Cundinamarca, Huila, Magdalena, Norte de Santander, Putumayo, Risaralda, Tolima, Valle); Ecuador; Peru","","text","",""]]},"XCH5":{"d":[["Ecuador","","text","",""]]},"Y8ZM":{"d":[["USA: Colorado","","text","native",""]]},"Z2DH":{"d":[["Afghanistan (Kabul)","","text","",""]]}}