iffers from other mayfly larvae observed by me in living condition, by unusual respiratory movements.","","text","",""]]},"NM3DC":{"d":[["","TW","iso","native",""]]},"P3YY":{"d":[["NE-Brazil (Bahia)","","text","",""]]},"P3Z8":{"d":[["Brazil","","text","",""]]},"PBVV7":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"PSRK5":{"d":[["Global","","text","native","critically endangered"]]},"PY5SD":{"d":[["Africa","","text","",""]]},"PYT5C":{"d":[["Brazil (Espírito Santo)","","text","",""]]},"QFLZ8":{"d":[["North America","","text","",""]]},"QMRXM":{"d":[["Global","","text","native","data deficient"]]},"RDQN":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"RJ83N":{"d":[["North America","","text","",""]]},"RJV6M":{"d":[["Iraq","2125","mrgid","native",""]]},"RKZK3":{"d":[["Distribution. Japan (Honshu, Kyushu).","","text","",""]]},"RNQSQ":{"d":[["Distribution: China: Jiangxi (Oriental region).","","text","",""]]},"RRQGY":{"d":[["AZO","","text","native",""],["AZO","","text","native",""],["AZO","","text","native",""],["AZO","","text","native",""]]},"S2K23":{"d":[["DISTRIBUTION. Northern Thailand: Chiangmai, 400 m above sea level.","","text","",""]]},"SPQJ7":{"d":[["Denmark","DK","iso","","not evaluated"]]},"SQCCK":{"d":[["Distribution. Costa Rica. NEW RECORDS: Panama, Colombia.","","text","",""]]},"SX6HL":{"d":[["North America","","text","",""]]},"T4YJJ":{"d":[["North America","","text","",""]]},"TW3MJ":{"d":[["Sweden","SE","iso","",""]]},"V3XGM":{"d":[["Southern Asia","","text","",""]]},"V4N9D":{"d":[["Distribution. INDIA: Meghalaya (new record), West Bengal; MYANMAR.","","text","",""]]},"W9XM":{"d":[["China","","text","native",""],["Sri Lanka","","text","native",""]]},"X3BH":{"d":[["Europe & Northern Asia (excluding China)","","text","",""]]},"XBD7":{"d":[["Mexico (Campeche, Chiapas, Colima, Durango, Guanajuato, Guerrero, Hidalgo, Jalisco, Michoacán, Nayarit, Oaxaca, Querétaro, San Luis Potosí, Sinaloa, Tamaulipas, Veracruz, Yucatan)