ive",""]]},"R52X":{"d":[["TASOO","","text","native",""]]},"R537":{"d":[["NSWCT","","text","native",""],["NSWNS","","text","native",""],["VICOO","","text","native",""]]},"RD23V":{"d":[["Distr.: Brazil — Minas Gerais.","","text","",""]]},"RD4G":{"d":[["Peru","","text","",""]]},"RLRYH":{"d":[["France","17","mrgid","native",""]]},"RRVW":{"d":[["Fiji","","text","native",""]]},"S266":{"d":[["Florida","","text","",""],["Georgia","","text","",""],["New Jersey","","text","",""],["North Carolina","","text","",""]]},"SCQ3W":{"d":[["Distribution and habitat occurrence. NE New South Wales (Fig. 13 b); open forest.","","text","",""]]},"T57NC":{"d":[["Sweden","SE","iso","native",""]]},"TNLWL":{"d":[["Distribution and bionomics (Map. 43). Compared to X. alexis, X. herrichschaefferi is more widely distributed from East of Russian Altai, northwest China, throughout Tuva, to East Sayan, along Mongolian Altai, to Hangai Range and easternmost to Ulan-Baator, and is partially sympatric with the former. It inhabits similar biotopes as X. alexis, but is more common in dry habitats e. g., mountain steppe, tundra-steppe and open mountain forest (Fig. 41). In the latter habitat both species fly in numbers, but X. alexis occurs at elevation 2300 – 2800 m and X. herrichschaefferi at 2100 – 2700 m. Species flying in sympatry are the same as those listed above for X. alexis. The behaviour of the females is similar to those of X. alexis. Males fly in July, attracted to light in great numbers. Notes. Xestia (R.) alexis and X. (R.) herrichschaefferi are the two most northerly distributed species of the Inner Asian subgenus Raddea, typical representatives of Mongolian-South Siberian alpine fauna, endemics of Altay-Sayan montane country. In habit they are similar to northernmost species of the subgenus Pachnobia. Brachypterous females are also known among species of the subgenus Pachnobia, in zonal tundra, dry stony cryoxerophylous slopes and barren rocks (Figs. 25 – 32) (i. e., X. aequaeva, X. alaskae, X. liquidaria, X. kurentzovi) (Kononenko 1981; Mikkola et al. 1983; Kullberg et al. 1995; Lafontaine et al. 1998). Brachyptery is also noted for Himalayan X. (Raddea) satanas (Hreblay & Ronkay 1998). Though no females are known in the other species of the subgenus Raddea, we expect that they will also prove to be brachypterous.","","text","",""]]},"TNTH3":{"d":[["Southern Asia","","text","",""]]},"TPTY":{"d":[["New Caledonian Exclusive Economic Zone","8312","mrgid","",""],["Wallis and Futuna Exclusive Economic Zone","8454","mrgid","",""]]},"TQ48":{"d":[["Afrotropical(Republic South Africa:Western Cape)","","text","",""]]},"TZ5BL":{"d":[["Africa","","text","",""]]},"TZL4C":{"d":[["Distribution. Southern California (Imperial, Los Angeles, and San Bernardino Counties).","","text","",""]]},"V3HJ6":{"d":[["Mexico (Campeche, Chiapas, Guerrero, Oaxaca, Quintana Roo, Yucatan); Honduras; Costa Rica; Hispaniola (Dominican Republic); Grenadines; St. Vincent; Colombia; Venezuela (Anzoategui, Aragua, Bolívar, Carabobo, Cojedes, Venezuela Distrito Federal, Falcon, Guarico, Lara, Miranda, Monagas, Nueva Esparta, Sucre, Trujillo, Yaracuy); NE-Brazil (Ceara, Paraíba, Pernambuco, Bahia); SE-Brazil (Minas Gerais, Espirito Santo, São Paulo, Rio de Janeiro); S-Brazil (Paraná)","","text","",""]]},"V5FH8":{"d":[["Sicily","","text","",""]]},"V8TBM":{"d":[["Distribution. Brazil (Amazonas).","","text","",""]]},"V93BM":{"d":[["China (Shaanxi)","","text","",""]]},"VCCCR":{"d":[["Western Cape","","text","",""]]},"VCK49":{"d":[["Geographic Rang e. — Known only from the type locality in Western Australia (Fig. 39). Flight Period. — 6 September, i. e. during the Australian early spring.","","text","",""]]},"VGB2":{"d":[["Kenyan Exclusive Economic Zone","8349","mrgid","",""],["Kerala","9003","mrgid","",""],["Madras","9023","mrgid","",""],["South Africa","18093","mrgid","",""],["Temperate Southern Africa","21716","mrgid","",""]]},"VK9W":{"d":[["S-Ethiopia; Kenya","","text","",""]]},"VVCB":{"d":[[